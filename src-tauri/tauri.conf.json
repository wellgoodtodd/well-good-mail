{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Well Good Mail",
  "version": "0.6.5",
  "identifier": "media.wellgood.mail",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Well Good Mail",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.googleapis.com https://oauth2.googleapis.com https://graph.microsoft.com https://login.microsoftonline.com https://github.com https://objects.githubusercontent.com; frame-src 'self' blob: data: about:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "licenseFile": "installer-licence.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNEE5NkVEMDA5OUMyMUUKUldRZXdwa0E3WlpLakJrcHZyS1VsRDF2aUJSd1lZV0Zma1JFV3JJNTNkK2syWVFnUk5NbnFtZVYK",
      "endpoints": [
        "https://github.com/wellgoodtodd/well-good-mail/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
